<Window x:Class="Tree.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Graph.View"
        mc:Ignorable="d"
        Title="Topology and Structure of a Directed Tree - " Height="1048" Width="1512" WindowStartupLocation="CenterScreen">
    <Grid Margin="22,0,0,21">
        <Grid.RowDefinitions>
            <RowDefinition Height="632*"/>
            <RowDefinition Height="387*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188"/>
            <ColumnDefinition Width="1260.62"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="416"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="#FF992614" BorderThickness="2" Width="192" Height="920" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,20,0,0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,20,0,8" ClipToBounds="False" HorizontalAlignment="Left" Width="173">
                <TextBlock x:Name="TDef"  HorizontalAlignment="Left" TextWrapping="WrapWithOverflow" VerticalAlignment="Top" Height="Auto" 
                           FontFamily="Calibri" FontSize="16" Margin="5,0" Width="160"/>
            </ScrollViewer>
        </Border>
        <Border BorderBrush="#FF2821BD" BorderThickness="2" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Height="965" Width="1198" Grid.Column="1" Grid.RowSpan="2">
            <Canvas x:Name="Board" ClipToBounds="False" Margin="30,18,133,-2"/>
        </Border>
        <Button Content="Select DiTree" HorizontalAlignment="Center" Margin="0,332,0,0" VerticalAlignment="Top" Width="110" Height="40" FontFamily="Comic Sans MS " FontSize="14" Click="Select_DiTree" BorderThickness="3" RenderTransformOrigin="0.525,2.805" Grid.Row="1"/>
    </Grid>
</Window>